{
  "name": "@onlinechefgroep/pi-agent-control-extension",
  "version": "5.2.1",
  "description": "Pi extension for terminal, CLI, browser-routing, capture, QA evidence, verification, usage observability, and control hub workflows",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-control",
    "terminal-automation",
    "browser-routing",
    "browser-cdp",
    "tui",
    "qa",
    "qa-evidence",
    "usage-observability",
    "verification",
    "showcase"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/pi-agent-control-extension.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "setup": "bash scripts/setup-deps.sh && bun install && (cd apps/remotion && bun install)",
    "validate": "py -3 scripts/validate-package.py || python3 scripts/validate-package.py || python scripts/validate-package.py",
    "check": "pi --offline --no-session --no-tools --no-skills --no-prompt-templates --no-extensions -e ./packages/extension/index.ts --list-models does-not-exist-xyz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "tsc --noEmit",
    "lint:python": "ruff check . && ruff format --check .",
    "pack:dry": "npm pack --dry-run",
    "showcase:render": "bunx tsx apps/remotion/scripts/render-showcase.ts",
    "showcase:preview": "echo 'Run /showcase-preview <recipe> in a Pi session'",
    "clean": "rm -rf coverage reports artifacts/telemetry/*.jsonl apps/remotion/node_modules/.cache apps/remotion/node_modules/.remotion && echo 'Caches en tijdelijke bestanden succesvol opgeruimd!'"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/extension/index.ts"
    ],
    "skills": [
      "./packages/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": ">=0.30.0"
  },
  "files": [
    "README.md",
    "CHANGELOG-v4.md",
    "CHANGELOG-v5.md",
    "extensions",
    "skills",
    "scripts",
    "bin",
    "remotion",
    "artifacts/demo/demo.gif"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "ink": "^7.0.4",
    "react": "^19.2.6",
    "tsx": "^4.22.3"
  }
}
