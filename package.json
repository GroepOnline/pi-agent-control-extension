{
  "name": "agy-agent-control-extension",
  "version": "5.1.1",
  "description": "Antigravity extension for terminal, CLI, browser-routing, capture, QA evidence, verification, usage observability, and control hub workflows",
  "type": "module",
  "keywords": [
    "agy-package",
    "agy-extension",
    "pi-package",
    "pi-extension",
    "agent-control",
    "terminal-automation",
    "browser-routing",
    "browser-cdp",
    "tui",
    "qa",
    "qa-evidence",
    "usage-observability",
    "verification",
    "showcase"
  ],
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup-deps.sh && npm install && (cd apps/remotion && npm install)",
    "validate": "py -3 scripts/validate-package.py || python3 scripts/validate-package.py || python scripts/validate-package.py",
    "check": "agy --offline --no-session --no-tools --no-skills --no-prompt-templates --no-extensions -e ./src/extension/index.ts --list-models does-not-exist-xyz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:count": "bash scripts/update-test-count.sh",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "tsc --noEmit",
    "lint:python": "ruff check . && ruff format --check .",
    "pack:dry": "npm pack --dry-run",
    "showcase:render": "npx tsx apps/remotion/scripts/render-showcase.ts",
    "showcase:preview": "echo 'Run /showcase-preview <recipe> in an agy session'",
    "clean": "rm -rf coverage reports artifacts/telemetry/*.jsonl apps/remotion/node_modules/.cache apps/remotion/node_modules/.remotion && echo 'Caches en tijdelijke bestanden succesvol opgeruimd!'"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./packages/skills"
    ]
  },
  "agy": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./packages/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": ">=0.30.0"
  },
  "files": [
    "README.md",
    "CHANGELOG-v5.md",
    "src",
    "packages/skills",
    "apps/remotion/src",
    "apps/remotion/scripts",
    "apps/remotion/public",
    "apps/remotion/package.json",
    "apps/remotion/remotion.config.ts",
    "apps/remotion/tsconfig.json",
    "bin",
    "scripts",
    "prompts",
    "artifacts/demo/demo.gif",
    "!apps/remotion/artifacts/**"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "ink": "^7.0.4",
    "react": "^19.2.6",
    "tsx": "^4.22.3"
  }
}
