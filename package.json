{
  "name": "pi-agent-control-extension",
  "version": "5.1.1",
  "description": "Pi extension for terminal, CLI, browser-routing, capture, QA evidence, verification, usage observability, and control hub workflows",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-control",
    "terminal-automation",
    "browser-routing",
    "browser-cdp",
    "tui",
    "qa",
    "qa-evidence",
    "usage-observability",
    "verification",
    "showcase"
  ],
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup-deps.sh && npm install && (cd remotion && npm install)",
    "validate": "py -3 scripts/validate-package.py || python3 scripts/validate-package.py || python scripts/validate-package.py",
    "check": "pi --offline --no-session --no-tools --no-skills --no-prompt-templates --no-extensions -e ./extensions/pi-control/index.ts --list-models does-not-exist-xyz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "tsc --noEmit",
    "lint:python": "ruff check . && ruff format --check .",
    "pack:dry": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-control/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "README.md",
    "CHANGELOG-v4.md",
    "CHANGELOG-v5.md",
    "extensions",
    "skills",
    "scripts",
    "bin",
    "remotion",
    "artifacts/demo/demo.gif"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
