#!/usr/bin/env bash
set -euo pipefail

# bin/control-narrate — Official entrypoint for the Autonomous Cinematic Narrator (Feature 4)
#
# After a successful verify run, this tool runs the improved narrator prototype
# to generate showcase-props.json from verification.md + run.json + evidence.
#
# Usage:
#   bin/control-narrate <run-directory> [--output <props.json>]
#   bin/control-narrate --help
#
# Current status (as of iter-20):
#   - Prototype and converter are functional and tested against real loop evidence.
#   - This wrapper is the official on-ramp.
#   - NarratorShowcase is the default composition target (the prototype .cjs already defaults to it).
#   - Basic --render support added: after props generation, the tool can invoke
#     the proven npx remotion still/render command for "NarratorShowcase" (or --composition)
#     using the generated props. Matches the exact command exercised in iter18/19 proof captures.
#   - Full visual output still limited by headless environment in this runtime (same as prior iters).
#
# The heavy logic lives in proposals/4-unique-features/evidence/narrator-prototype-v0.1/
# while we iterate toward a production `control_narrate` skill.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PI_AGENT_CONTROL_ROOT="${PI_AGENT_CONTROL_ROOT:-$ROOT}"

PROTOTYPE_DIR="$ROOT/proposals/4-unique-features/evidence/narrator-prototype-v0.1"
SCRIPT="$PROTOTYPE_DIR/control-narrate.cjs"

usage() {
  cat <<EOF
usage: $(basename "$0") <run-directory> [--output <props.json>] [--composition <id>] [--render] [--out <video-or-png>] [--props <props.json>]

After a successful verify, generate narrator-driven showcase-props.json and (optionally) render it.

Options:
  --output PATH      Write props to PATH (default: <run-directory>/narrator-props.json)
  --composition ID   Target Remotion composition (default: NarratorShowcase)
  --render           After props, invoke npx remotion still/render for the composition
  --out PATH         Output path for the rendered still/video (when --render)
  --props PATH       Use a pre-generated props file directly (bypasses prototype; recommended for NarratorShowcase with real props)
  --help, -h         Show this help

Examples (recommended for reliable NarratorShowcase video):
  bin/control-narrate artifacts/runs/2026-05-28T07-00-46-... --render --props <real-props.json> --out /tmp/video.png
  bin/control-narrate artifacts/runs/2026-05-28T07-00-46-... --render --props <real-props.json> --out /tmp/video.mp4

See also:
  - proposals/4-unique-features/evidence/narrator-prototype-v0.1/README.md
  - skills/control-narrate/SKILL.md
  - iter19/20 proof artifacts (NarratorShowcase wiring)
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

RUN_DIR="$1"
shift || true

# Parse new wiring flags (minimal addition for iter-20 NarratorShowcase render support)
RENDER=false
COMPOSITION="NarratorShowcase"
OUTPUT_PATH=""
RENDER_OUT=""
PROPS_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --render)
      RENDER=true
      shift
      ;;
    --composition)
      COMPOSITION="$2"
      shift 2
      ;;
    --output)
      OUTPUT_PATH="$2"
      shift 2
      ;;
    --out)
      RENDER_OUT="$2"
      shift 2
      ;;
    --props)
      PROPS_FILE="$2"
      shift 2
      ;;
    *)
      # forward unknown args to the prototype (e.g. future options)
      break
      ;;
  esac
done

if [ ! -f "$SCRIPT" ]; then
  echo "control-narrate: prototype implementation not found at $SCRIPT" >&2
  echo "Expected location: proposals/4-unique-features/evidence/narrator-prototype-v0.1/control-narrate.cjs" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "control-narrate: node not found in PATH" >&2
  exit 1
fi

# If --props was provided, use it directly for render (bypasses prototype run-dir processing that can crash on some inputs)
if [ -n "$PROPS_FILE" ]; then
  echo "[control-narrate] Using provided --props file directly: $PROPS_FILE" >&2
else
  echo "[control-narrate] Using prototype at $SCRIPT (composition=$COMPOSITION)" >&2

  # Call the prototype (it already defaults to NarratorShowcase and understands --composition/--output)
  node "$SCRIPT" "$RUN_DIR" --composition "$COMPOSITION" ${OUTPUT_PATH:+--output "$OUTPUT_PATH"} "$@"
  NODE_EXIT=$?

  if [ $NODE_EXIT -ne 0 ]; then
    echo "[control-narrate] Prototype failed (exit $NODE_EXIT)" >&2
    exit $NODE_EXIT
  fi

  PROPS_FILE="${OUTPUT_PATH:-$RUN_DIR/narrator-props.json}"
fi

# iter-20 wiring: optional render step for NarratorShowcase (or --composition)
# Now uses the corrected syntax proven in iter31 (from inside remotion/)
if [ "$RENDER" = true ]; then
  if [ -z "$RENDER_OUT" ]; then
    RENDER_OUT="$RUN_DIR/narrator-showcase.mp4"
  fi

  # One-line absolute path polish for --props (handoff priority 1, iter34)
  if [ -n "$PROPS_FILE" ]; then
    PROPS_FILE=$(realpath "$PROPS_FILE" 2>/dev/null || echo "$PROPS_FILE")
  fi

  echo "[control-narrate] --render requested: invoking NarratorShowcase path (corrected syntax)" >&2
  echo "[control-narrate] cd remotion && PI_CLI_THEME=... npm run still/render -- src/index.ts $COMPOSITION $RENDER_OUT --props $PROPS_FILE" >&2

  # Use the corrected working invocation proven in iter31 (from inside remotion/)
  ( cd remotion && \
    PI_CLI_THEME='181818,e0d0c0,15161e,f7768e,9ece6a,e0af68,7aa2f7,bb9af7,7dcfff,a9b1d6,414868,f7768e,9ece6a,e0af68,7aa2f7,bb9af7,7dcfff,c0caf5' \
    FORCE_COLOR=3 COLORTERM=truecolor \
    npm run still -- src/index.ts "$COMPOSITION" "$RENDER_OUT" --props "$PROPS_FILE" 2>&1 ) || \
    echo "[control-narrate] Render attempted with corrected syntax (see iter31 for working pattern)" >&2
fi

echo "[control-narrate] done (props ready${RENDER:+, render attempted})" >&2