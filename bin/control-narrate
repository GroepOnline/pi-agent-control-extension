#!/usr/bin/env bash
# bin/control-narrate — Thin entrypoint for the Autonomous Cinematic Narrator
# Delegates directly to the TypeScript implementation in src/showcase/control-narrate.ts

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PI_AGENT_CONTROL_ROOT="${PI_AGENT_CONTROL_ROOT:-$ROOT}"

if ! command -v node >/dev/null 2>&1; then
  echo "control-narrate: node not found in PATH" >&2
  exit 1
fi

npx tsx "$ROOT/src/showcase/control-narrate.ts" "$@"