# Monorepo build artifacts and dev dependencies
node_modules/
apps/remotion/node_modules/
apps/remotion/package-lock.json
apps/remotion/artifacts/

# Test files (~140 kB of bloat — never shipped to consumers)
src/**/*.test.ts
src/**/*.test.tsx
src/**/*.bench.ts
apps/remotion/src/**/*.test.ts

# Test artifacts and coverage
src/coverage/
coverage/

# Build outputs that should never be in the tarball
dist/

# Local agent / dev tooling caches
.factory/
.claude/
.ruff_cache/
.venv/

# Lockfile and runtime noise
package-lock.json
*.log
.env
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Coverage
coverage/
apps/remotion/coverage/

# Remotion build output
apps/remotion/artifacts/

# Large evidence recordings
docs/proposals/**/evidence/**
